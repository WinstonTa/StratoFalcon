REACTOR_API_KEY=replace_with_your_reactor_api_key
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional. reactor/visko-orbis-dynamic (default) or reactor/visko-orbis-stable.
# Inlined at build time: restart the dev server after changing it.
NEXT_PUBLIC_ORBIS_MODEL=reactor/visko-orbis-dynamic

# Optional locally, required on any public deployment. When set, /api/token
# refuses requests that do not send this code.
DEMO_ACCESS_CODE=
